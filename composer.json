{
    "name": "tairesh/unique-names-generator",
    "description": "Deterministic readable names derived from any key, with guaranteed-distinct retries.",
    "keywords": [
        "random",
        "name",
        "generator",
        "slug",
        "animal",
        "color",
        "adjective"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ilia Agafonov",
            "email": "tairesh.rus@gmail.com"
        },
        {
            "name": "Nicolas",
            "email": "chypriote@lolpros.gg",
            "role": "Author of the original package"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2"
    },
    "autoload": {
        "psr-4": {
            "Chypriote\\UniqueNames\\": "src",
            "Chypriote\\UniqueNames\\Tests\\": "tests"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chypriote\\UniqueNames\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
